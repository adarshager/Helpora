
# ---------- AI mode (optional: add ONE; with none the bot uses offline mode) ----------
=======
# Add ONE key to enable AI mode. Leave both empty to use the free offline mode.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash


# ---------- Agent desk (required to log in at /agent) ----------
AGENT_USERNAME=agent
AGENT_PASSWORD=
SECRET_KEY=
# Public address of your site, used for links in alerts, e.g. https://helpora.onrender.com
BASE_URL=http://127.0.0.1:5000

# ---------- Database (leave empty to use a local SQLite file) ----------
DATABASE_URL=

# ---------- Instant agent alerts (all optional) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# ---------- Email through the Brevo API (optional) ----------
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Helpora Support
AGENT_NOTIFY_EMAIL=
=======
# Optional: lets you read saved support tickets at /admin/tickets?key=YOUR_KEY
ADMIN_KEY=

